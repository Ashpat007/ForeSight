# ForeSight Backend — Environment Variables Template
# Copy this file, rename it to .env, and fill in your own values.
# DO NOT commit .env to Git.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/forecastDB

# Server port
PORT=5000

# JWT signing secret — generate a strong random string (min 64 chars)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_own_strong_secret

# Allowed frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
